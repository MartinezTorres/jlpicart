{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "shell",
            //"isBuildCommand": true,
            "command": "${workspaceFolder}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-size -A -x ${workspaceFolder}/build/jlpicart.elf",
            "group": "build",
            "presentation": {
                "echo": true,
                "clear": false,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": ["Ninja"]
        },
        {
            "label": "Ninja",
            "type": "process",
            "command": "${workspaceFolder}/.pico-sdk/ninja/v1.12.1/ninja",
            "args": ["-C", "${workspaceFolder}/build"],
            //"group": "build",
            "presentation": {
                "echo": true,
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash (picotool)",
            "type": "process",
            "command": "${workspaceFolder}/.pico-sdk/picotool/2.2.0/picotool",
            "args": ["load", "${workspaceFolder}/build/jlpicart.uf2", "--force"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
