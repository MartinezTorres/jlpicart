{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Run Banana Remote",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/jlpicart.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "192.168.17.205:3333",
            "showDevDebugOutput": "raw",
            "gdbPath": "${workspaceFolder}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "rp2350b",
            "svdFile": "${workspaceFolder}/.pico-sdk/sdk/2.2.0/src/rp2350/hardware_regs/rp2350.svd",
            "runToEntryPoint": "main",
            // Give restart the same functionality as runToEntryPoint - main
            "postRestartCommands": [
                "break main",
                "continue"
            ]
        }
    ]
}
