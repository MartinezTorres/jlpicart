                                      1     .module z80_stub
                                      2 
                                      3 .globl  ___ML_CONFIG_RAM_START
                                      4 .globl  ___ML_CONFIG_INIT_ROM_START
                                      5 .globl  ___ML_CONFIG_INIT_RAM_START
                                      6 .globl  ___ML_CONFIG_INIT_SIZE
                                      7 
                           00E000     8 ___ML_CONFIG_RAM_START  =   0xE000
                                      9 
                           004030    10 EXEC_START =   0x4030
                           007FFF    11 WRITE_MAPPED_ADDRESS =   0x7FFF
                                     12 
                                     13 ;--------------------------------------------------------
                                     14 ; HEADER
                                     15 ;--------------------------------------------------------
                                     16 
                                     17 .area _HEADER (ABS)
                                     18 ; Reset vector
      004000                         19     .org 0x4000
      004000 41                      20     .db  0x41
      004001 42                      21     .db  0x42
      004002 18 40                   22     .dw  init
      004004 00 00                   23     .dw  0x0000
      004006 00 00                   24     .dw  0x0000
      004008 00 00                   25     .dw  0x0000
      00400A 00 00                   26     .dw  0x0000
      00400C 00 00                   27     .dw  0x0000
      00400E 00 00                   28     .dw  0x0000
                                     29 
      004010                         30 boot_trampoline:
      004010 2A 02 40         [16]   31     ld hl, (#0x4002)
      004013 7C               [ 4]   32     ld a, h
      004014 B7               [ 4]   33     or a
      004015 28 F9            [12]   34     jr z, boot_trampoline
      004017 E9               [ 4]   35     jp (hl)
                                     36 
      004018                         37 init:
                                     38 
      004018 F3               [ 4]   39     di
                                     40 
      004019 11 00 00         [10]   41     ld de, #___ML_CONFIG_INIT_RAM_START
      00401C 21 10 40         [10]   42     ld hl, #boot_trampoline
      00401F 01 08 00         [10]   43     ld bc, #(init - boot_trampoline)
      004022 ED B0            [21]   44 	ldir
                                     45 
      004024 11 FF 7F         [10]   46     ld de, #WRITE_MAPPED_ADDRESS
      004027 21 30 40         [10]   47     ld hl, #EXEC_START
      00402A E9               [ 4]   48     jp (hl)
